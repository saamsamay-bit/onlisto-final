rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getRole() {
      return get(/databases/$(database)/documents/orderTracker_roles/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return request.auth != null && getRole().role in ['admin', 'superadmin'];
    }
    
    function isPanacea() {
      return request.auth != null && getRole().role == 'team' && getRole().teamLabel == 'panacea';
    }
    
    function isSamayy() {
      return request.auth != null && getRole().role == 'team' && getRole().teamLabel == 'samayy';
    }
    
    function canAccessTeam(team) {
      return isAdmin() || (isPanacea() && team == 'panacea') || (isSamayy() && team == 'samayy');
    }

    match /orderTracker_orders/{doc} {
      allow read: if request.auth != null && canAccessTeam(resource.data.team);
      allow create: if request.auth != null && canAccessTeam(request.resource.data.team);
      allow update: if request.auth != null && canAccessTeam(resource.data.team) && canAccessTeam(request.resource.data.team);
      allow delete: if isAdmin();
    }

    match /orderTracker_listings/{doc} {
      allow read: if request.auth != null && canAccessTeam(resource.data.team);
      allow create: if request.auth != null && canAccessTeam(request.resource.data.team);
      allow update: if request.auth != null && canAccessTeam(resource.data.team) && canAccessTeam(request.resource.data.team);
      allow delete: if isAdmin();
    }

    match /orderTracker_disputes/{doc} {
      allow read: if request.auth != null && canAccessTeam(resource.data.team);
      allow write: if isAdmin();
    }

    match /orderTracker_vaPerformance/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || resource.data.team == getRole().teamLabel);
    }

    match /orderTracker_messages/{doc} {
      allow read: if request.auth != null && (resource.data.toRole == getRole().teamLabel || resource.data.fromRole == getRole().teamLabel || isAdmin());
      allow create: if request.auth != null;
    }

    match /orderTracker_bannedBrands/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /orderTracker_expenses/{doc} {
      allow read, write: if isAdmin();
    }

    match /orderTracker_settings/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /orderTracker_clients/{doc} {
      allow read, write: if isAdmin();
    }

    match /orderTracker_insights/{doc} {
      allow read, write: if isAdmin();
    }

    match /orderTracker_roles/{doc} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == doc);
      allow write: if isAdmin();
    }
  }
}
